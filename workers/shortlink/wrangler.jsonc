{
	"name": "saisai-shortlink",
	"main": "index.js",
	"compatibility_date": "2026-11-17",
	// 只接管 /s 和 /s/*。不要写成 saisai.me/s*，那样会把 /sudoku/ 也拦下来。
	"routes": [
		{ "pattern": "saisai.me/s", "zone_name": "saisai.me" },
		{ "pattern": "saisai.me/s/*", "zone_name": "saisai.me" }
	],
	"workers_dev": false,
	"kv_namespaces": [
		{ "binding": "LINKS", "id": "71b6764ca0c04bcb84bf72603e4b2e5a" }
	],
	// 每个 IP 每分钟最多生成 10 条短链（按 Cloudflare 节点分别计数）。
	"ratelimits": [
		{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	]
}
